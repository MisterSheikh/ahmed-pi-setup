{
  "name": "ahmed-pi-setup",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "extensions/*"
  ],
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"extensions/**/*.{ts,json}\" package.json tsconfig.json",
    "format:check": "prettier --check \"extensions/**/*.{ts,json}\" package.json tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@effect/platform-node-shared": "4.0.0-rc.110",
    "@effect/tsgo": "0.36.5",
    "@types/node": "26.2.0",
    "effect": "4.0.0-rc.110",
    "prettier": "3.9.6",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
